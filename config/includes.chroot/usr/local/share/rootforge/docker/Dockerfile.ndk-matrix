# RootForge OS — NDK/API version matrix build image
# Victorious Framework
#
# Parameterized so build_matrix.sh can spin up one image per
# {NDK_VERSION, API_LEVEL} combination without polluting the host toolchain.
# Build args, not env-baked assumptions, so the matrix script controls
# exactly what's under test.

ARG NDK_VERSION=26.1.10909125
ARG API_LEVEL=34

FROM debian:bookworm-slim

ARG NDK_VERSION
ARG API_LEVEL
ENV NDK_VERSION=${NDK_VERSION}
ENV API_LEVEL=${API_LEVEL}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    curl unzip git ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV ANDROID_SDK_ROOT=/opt/android-sdk
RUN mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools && \
    curl -sSL -o /tmp/cmdline-tools.zip \
      "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" && \
    unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools && \
    mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip

ENV PATH=${PATH}:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools

RUN yes | sdkmanager --sdk_root=${ANDROID_SDK_ROOT} --licenses > /dev/null 2>&1 || true && \
    sdkmanager --sdk_root=${ANDROID_SDK_ROOT} \
      "platform-tools" \
      "platforms;android-${API_LEVEL}" \
      "build-tools;34.0.0" \
      "ndk;${NDK_VERSION}"

ENV ANDROID_NDK_ROOT=${ANDROID_SDK_ROOT}/ndk/${NDK_VERSION}
WORKDIR /project

# RootForge convention: the matrix script bind-mounts the module/kernel
# project into /project and passes the build command as CMD at `docker run`
# time — this image only fixes the toolchain, not the build steps.
LABEL org.rootforge.victorious="true"
