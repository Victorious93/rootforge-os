# RootForge OS — core toolchain package list
# Victorious Framework | Origin Source Labs
#
# Every apt-installable package needed for Android root-module development
# (README section 2). Android SDK/NDK are fetched at first boot by
# 00_bootstrap_distro.sh — not baked here.

# Base build utilities
build-essential
git
curl
wget
unzip
zip
rsync
ccache
gnupg
lsb-release
ca-certificates
software-properties-common

# Java (Android Gradle Plugin 8.x baseline)
openjdk-17-jdk

# Python (for avbtool, mkbootimg, various scripts)
python3
python3-pip
python3-venv
python3-yaml

# Kernel cross-compilation toolchain
clang
lld
llvm
binutils-aarch64-linux-gnu
gcc-aarch64-linux-gnu
bc
bison
flex
libssl-dev
libelf-dev
dwarves
cpio
kmod
rsync

# KVM emulator acceleration
qemu-kvm
libvirt-daemon-system
virtinst
bridge-utils
cpu-checker

# ADB / fastboot
android-sdk-platform-tools-common
adb
fastboot

# Boot image / sparse image tools
# simg2img/img2simg were merged into android-sdk-libsparse-utils on Debian
# bookworm — the old package name has no installation candidate there.
android-sdk-libsparse-utils
abootimg
e2fsprogs

# Script tooling dependencies (README section 2)
jq
docker.io

# Gradle (standalone, for Magisk/module builds outside Android Studio)
gradle

# GNOME desktop (lean selection — not the full gnome meta-package)
gnome-session
gnome-shell
gnome-terminal
gnome-control-center
gnome-tweaks
nautilus
gdm3

# Fonts
fonts-jetbrains-mono

# Plymouth boot splash
plymouth
plymouth-themes

# Live system essentials
live-boot
live-config
live-config-systemd
sudo
locales
network-manager
network-manager-gnome
pulseaudio

# Firmware (WiFi/GPU/etc for real hardware) — installed explicitly rather
# than relying on live-build's --firmware-chroot auto-discovery, which
# doesn't work on this live-build version (see auto/config's header)
firmware-linux

# isohybrid — lb_binary_iso runs it chrooted (LB_BUILD_WITH_CHROOT
# defaults true) to make the finished ISO USB-bootable as well as
# BIOS-bootable, via `Chroot chroot "sh binary.sh"`. live-build's own
# dependency check for this (`Check_package chroot/usr/bin/isohybrid
# syslinux`) auto-installs the wrong package — isohybrid actually ships
# in syslinux-utils, not the bare syslinux package — confirmed by a real
# build reaching the very last step (xorriso had already written the
# full ISO) and failing with "binary.sh: isohybrid: not found". Installing
# the right package ourselves sidesteps live-build's stale check entirely.
syslinux-utils

# isolinux — provides /usr/lib/ISOLINUX/isolinux.bin, which
# config/bootloaders/isolinux/isolinux.bin now symlinks to (see that
# directory's own header in HACKING.md). lb_binary_syslinux's own
# dependency check only auto-installs syslinux + syslinux-common into
# the chroot, never the separate isolinux package, so this needs to be
# explicit — confirmed by a real build failure ("cp: cannot stat
# '/root/isolinux/isolinux.bin': No such file or directory") the first
# time this bootloader-theme-copy step was ever reached.
isolinux
