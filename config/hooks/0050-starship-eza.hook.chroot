#!/bin/sh
# RootForge OS — starship prompt + eza install
# Victorious Framework | Origin Source Labs
#
# Neither starship nor eza is in Debian 12 main repos.
#   starship: installed via its official curl installer
#   eza:      installed from the official GitHub release .deb
#             (replaces the deprecated 'exa'; Bookworm backports may have it
#              but the release .deb is more reliably current)

set -e

# --- starship ---
echo "==> Installing starship prompt"
curl -sS https://starship.rs/install.sh | sh -s -- --yes
starship --version

# --- eza ---
echo "==> Installing eza"
DPKG_ARCH="$(dpkg --print-architecture)"
case "$DPKG_ARCH" in
  amd64) EZA_TARGET="x86_64-unknown-linux-gnu" ;;
  arm64) EZA_TARGET="aarch64-unknown-linux-gnu" ;;
  *) EZA_TARGET="" ;;
esac

if [ -z "$EZA_TARGET" ]; then
  echo "WARNING: no known eza release target for dpkg architecture '$DPKG_ARCH' — skipping eza install."
else
  # strict=False: a sibling hook hitting a different GitHub releases API
  # (0060-magiskboot) hit a real "Invalid control character" JSONDecodeError
  # from a raw control char somewhere in the payload (likely a release-notes
  # body) — relaxing strictness here too since we only need tag_name, never
  # the body, and the same class of API can carry the same class of quirk.
  EZA_TAG=$(curl -fsSL https://api.github.com/repos/eza-community/eza/releases/latest \
    | python3 -c "import sys,json; print(json.load(sys.stdin, strict=False)['tag_name'])")
  EZA_URL="https://github.com/eza-community/eza/releases/download/${EZA_TAG}/eza_${EZA_TARGET}.tar.gz"
  # [Certain] the release tarball's sole member is "./eza" (verified by
  # downloading and listing a real one), not a bare "eza" — asking tar to
  # extract a specific member named "eza" therefore never matches and always
  # fails with "Not found in archive". Extracting without a member filter
  # instead lands "./eza" at exactly /usr/local/bin/eza, which is what we want.
  curl -fsSL "$EZA_URL" | tar -xz -C /usr/local/bin
  chmod +x /usr/local/bin/eza
  eza --version
fi

echo "==> starship + eza install complete"
