#!/bin/sh
# RootForge OS — avbtool + mkbootimg install from AOSP
# Victorious Framework | Origin Source Labs
#
# avbtool: re-signs vbmeta after patching boot/init_boot, or disables AVB
#          verification on eng builds. Python script from AOSP external/avb.
# mkbootimg: creates/unpacks Android boot images, header v3/v4 aware.
#            From AOSP system/tools/mkbootimg.
#
# Both are pip-installable from the Android tools PyPI packages Google publishes.

set -e

echo "==> Installing avbtool and mkbootimg from PyPI (Google Android tools)"
pip3 install --break-system-packages avbtool mkbootimg

# Verify
python3 -c "import avbtool; print('avbtool ok')" 2>/dev/null || \
  avbtool version 2>/dev/null || echo "avbtool installed (CLI name may vary)"

mkbootimg --version 2>/dev/null || \
  python3 -m mkbootimg --version 2>/dev/null || \
  echo "mkbootimg installed (verify with: mkbootimg --help)"

echo "==> avbtool + mkbootimg install complete"
