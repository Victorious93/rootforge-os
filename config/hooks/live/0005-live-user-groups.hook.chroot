#!/bin/sh
# RootForge OS — live session user group membership
# Victorious Framework | Origin Source Labs
#
# Adds the default live user (live-build names it 'user') to the groups
# needed for USB device access, KVM emulator acceleration, and Docker
# in the live session. Without this, adb/fastboot see the device but
# permission-deny on the USB node, and the emulator falls back to
# software rendering.
#
# Groups added:
#   kvm      — /dev/kvm access for QEMU/Android emulator acceleration
#   plugdev  — USB device access (udev rules in 51-android.rules use this)
#   docker   — docker daemon socket

set -e

LIVE_USER="user"

for grp in kvm plugdev docker; do
  if getent group "$grp" >/dev/null 2>&1; then
    usermod -aG "$grp" "$LIVE_USER" && echo "==> Added $LIVE_USER to $grp"
  else
    echo "WARNING: group '$grp' does not exist yet — will be created by its package"
  fi
done
