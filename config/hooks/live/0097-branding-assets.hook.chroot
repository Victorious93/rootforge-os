#!/usr/bin/env python3
# RootForge OS — generate Calamares branding logo PNG
# Victorious Framework | Origin Source Labs
#
# Generates logo.png for /etc/calamares/branding/rootforge/ at build time.
# No ImageMagick or Pillow dependency — constructs a valid PNG with stdlib
# struct/zlib. 256x256, dark background (#0d0d0d), green (#00ff41) text
# would require a font renderer; instead this produces a solid-colour
# placeholder that Calamares accepts as a valid logo image.
# The show.qml slideshow handles the visual branding; the logo is only used
# in the Calamares window title bar and about dialog.

import struct
import zlib
import os

OUT = "/etc/calamares/branding/rootforge/logo.png"

def png_chunk(tag, data):
    c = struct.pack(">I", len(data)) + tag + data
    return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

def make_png(width, height, r, g, b):
    sig = b'\x89PNG\r\n\x1a\n'
    ihdr = png_chunk(b'IHDR', struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
    # Build raw image: each row is filter byte (0) + RGB pixels
    row = bytes([0]) + bytes([r, g, b] * width)
    raw = row * height
    idat = png_chunk(b'IDAT', zlib.compress(raw, 9))
    iend = png_chunk(b'IEND', b'')
    return sig + ihdr + idat + iend

os.makedirs(os.path.dirname(OUT), exist_ok=True)
with open(OUT, 'wb') as f:
    # 256x256 solid #0d0d0d (dark background matching the theme)
    f.write(make_png(256, 256, 0x0d, 0x0d, 0x0d))

print(f"==> logo.png generated: {OUT}")
