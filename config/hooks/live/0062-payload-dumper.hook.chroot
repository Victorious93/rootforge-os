#!/bin/sh
# RootForge OS — payload-dumper-go prebuilt install
# Victorious Framework | Origin Source Labs
#
# payload-dumper-go extracts partition images from Android OTA payload.bin files.
# extract_ota.sh self-installs it at first run, but baking it into the squashfs
# means it's available immediately in the live session without a network fetch.

set -e

PD_API="https://api.github.com/repos/ssut/payload-dumper-go/releases/latest"
INSTALL_DIR="/usr/local/bin"

DPKG_ARCH="$(dpkg --print-architecture)"
case "$DPKG_ARCH" in
  amd64|arm64) PD_ARCH="$DPKG_ARCH" ;;
  *) PD_ARCH="" ;;
esac

if [ -z "$PD_ARCH" ]; then
  echo "WARNING: no known payload-dumper-go release asset for dpkg architecture '$DPKG_ARCH' — extract_ota.sh will self-install it at runtime if that arch is supported there."
  exit 0
fi

echo "==> Fetching payload-dumper-go latest release ($PD_ARCH)"
PD_URL=$(curl -fsSL "$PD_API" | PD_ARCH="$PD_ARCH" python3 -c "
import sys, json, os
assets = json.load(sys.stdin)['assets']
pattern = 'linux_' + os.environ['PD_ARCH']
match = [a for a in assets if pattern in a['name'] and a['name'].endswith('.tar.gz')]
print(match[0]['browser_download_url'] if match else '')
")

[ -z "$PD_URL" ] && { echo "WARNING: payload-dumper-go release not found — extract_ota.sh will self-install it at runtime."; exit 0; }

echo "==> Downloading: $PD_URL"
TMPDIR=$(mktemp -d)
curl -fsSL -o "$TMPDIR/pd.tar.gz" "$PD_URL"
tar -xz -C "$TMPDIR" -f "$TMPDIR/pd.tar.gz"
find "$TMPDIR" -name "payload-dumper-go" -exec install -m 0755 {} "$INSTALL_DIR/payload-dumper-go" \;
rm -rf "$TMPDIR"

echo "==> payload-dumper-go installed: $("$INSTALL_DIR/payload-dumper-go" --version 2>/dev/null || echo 'ok')"
