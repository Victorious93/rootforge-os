#!/bin/sh
# RootForge OS — magiskboot prebuilt install
# Victorious Framework | Origin Source Labs
#
# magiskboot is the core tool for unpacking/repacking Android boot images —
# used by kernelsu_patch_boot.sh, flash_patched_boot.sh, and others.
# It lives in Magisk's native tree and isn't in any apt repo.
#
# Strategy: fetch the latest Magisk release APK (it's a zip), extract the
# magiskboot binary matching this chroot's own architecture from the assets
# inside, install to /usr/local/bin. This is the same binary Magisk ships
# on-device — it runs fine on a matching-arch Linux host (or, for the
# Termux/PRoot rootfs build, matching-arch Android).

set -e

MAGISK_API="https://api.github.com/repos/topjohnwu/Magisk/releases/latest"
WORK_DIR="/tmp/magiskboot-extract"
mkdir -p "$WORK_DIR"

DPKG_ARCH="$(dpkg --print-architecture)"
case "$DPKG_ARCH" in
  amd64) MAGISK_ABI="x86_64" ;;
  arm64) MAGISK_ABI="arm64-v8a" ;;
  armhf) MAGISK_ABI="armeabi-v7a" ;;
  i386)  MAGISK_ABI="x86" ;;
  *) echo "WARNING: unrecognized dpkg architecture '$DPKG_ARCH' — defaulting to x86_64 magiskboot, which likely won't run here."; MAGISK_ABI="x86_64" ;;
esac

echo "==> Fetching latest Magisk release metadata"
RELEASE_JSON=$(curl -fsSL "$MAGISK_API")

# Magisk releases the APK as magisk-<version>.apk — it's a zip containing
# lib/<abi>/libmagiskboot.so which is a standalone ELF, despite the .so name
APK_URL=$(echo "$RELEASE_JSON" | python3 -c "
import sys, json
# strict=False: confirmed by a real build failure that GitHub's release
# JSON for this repo can carry a raw control character somewhere in the
# payload (most likely the free-text release-notes body) — Python's
# default strict json.load rejects that even though we only need the
# small, well-formed 'assets' field, never the body itself.
assets = json.load(sys.stdin, strict=False)['assets']
apk = [a for a in assets if a['name'].endswith('.apk') and 'stub' not in a['name']]
print(apk[0]['browser_download_url'] if apk else '')
")

[ -z "$APK_URL" ] && { echo "WARNING: Could not find Magisk APK URL — magiskboot will be absent. Scripts will error at runtime if it's needed."; exit 0; }

echo "==> Downloading Magisk APK from $APK_URL"
curl -fsSL -o "$WORK_DIR/magisk.apk" "$APK_URL"

echo "==> Extracting magiskboot ($MAGISK_ABI) from APK"
unzip -p "$WORK_DIR/magisk.apk" "lib/${MAGISK_ABI}/libmagiskboot.so" > /usr/local/bin/magiskboot
chmod +x /usr/local/bin/magiskboot
rm -rf "$WORK_DIR"

echo "==> magiskboot installed: $(magiskboot 2>&1 | head -1 || true)"
