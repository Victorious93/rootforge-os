#!/bin/sh
# RootForge OS — NodeSource LTS repository + Node.js install
# Victorious Framework | Origin Source Labs
#
# Debian 12's packaged Node.js is too old for Claude Code. This hook adds the
# NodeSource LTS repo and installs the current LTS release at build time.
# The package list rootforge-ai.list.chroot lists 'npm' as a hint; the actual
# node binary comes from this hook's repo, which satisfies that dependency.

set -e

KEYRING_URL="https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key"
KEYRING_PATH="/usr/share/keyrings/nodesource.gpg"

# Node 22 or newer: the pinned Claude Code release (hook 0030) declares
# engines.node ">=22.0.0", and Node 20 reached end of life in April 2026.
NODE_MAJOR=22

# Fingerprints of the keys this repository is signed with, observed in the
# key NodeSource published at KEYRING_URL on 2026-10-07 (trust on first use:
# not cross-checked against a second source). The key is fetched over TLS,
# so without this a changed or substituted key would be trusted silently.
# If NodeSource rotates its key this fails the build on purpose: confirm the
# new fingerprints from NodeSource's own documentation, then update the list.
EXPECTED_FINGERPRINTS="0FA5ECC8C0CA58863C0AC5867E9656125E955B26
6F71F525282841EEDAF851B42F59B5F99B1BE0B4"

echo "==> Installing NodeSource LTS repository"
KEY_TMP="$(mktemp)"
if ! curl -fsSL -o "$KEY_TMP" "$KEYRING_URL" || [ ! -s "$KEY_TMP" ]; then
  rm -f "$KEY_TMP"
  echo "ERROR: could not download the NodeSource signing key." >&2
  exit 1
fi
ACTUAL_FINGERPRINTS="$(gpg --show-keys --with-colons "$KEY_TMP" | awk -F: '$1 == "fpr" { print $10 }' | sort -u)"
if [ "$ACTUAL_FINGERPRINTS" != "$EXPECTED_FINGERPRINTS" ]; then
  rm -f "$KEY_TMP"
  echo "ERROR: the NodeSource signing key is not the pinned one." >&2
  echo "       expected:" >&2
  echo "$EXPECTED_FINGERPRINTS" | sed 's/^/         /' >&2
  echo "       actual:" >&2
  echo "$ACTUAL_FINGERPRINTS" | sed 's/^/         /' >&2
  exit 1
fi
gpg --dearmor -o "$KEYRING_PATH" < "$KEY_TMP"
rm -f "$KEY_TMP"

echo "deb [signed-by=$KEYRING_PATH] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
  > /etc/apt/sources.list.d/nodesource.list

# [Certain] retry apt-get update, clearing the list cache first: confirmed
# across six separate CI runs that apt-get update can fail here under
# qemu-user-static arm64 emulation (termux/build-rootfs.sh's cross-arch
# case) with "getline (12: Cannot allocate memory)" reading an apt list
# file — a known category of qemu-user syscall-translation flakiness,
# never observed natively on amd64. A bare retry alone doesn't help: apt
# treats the on-disk list as unchanged (logs "Hit:", not "Get:") and
# never re-fetches it, so every attempt re-reads the same bad file and
# fails identically — confirmed by a real build retrying 3 times with the
# exact same error each time. Clearing the cached lists before each retry
# forces a real re-download instead of re-reading the same file.
n=0
until apt-get update -q; do
  n=$((n + 1))
  [ "$n" -ge 3 ] && { echo "ERROR: apt-get update failed $n times, giving up"; exit 1; }
  echo "WARNING: apt-get update failed (attempt $n/3) — clearing list cache, retrying in 5s"
  rm -rf /var/lib/apt/lists/*
  sleep 5
done
apt-get install -y --no-install-recommends nodejs
NODE_VERSION="$(node --version)"
case "$NODE_VERSION" in
  "v${NODE_MAJOR}."*) ;;
  *) echo "ERROR: expected Node.js ${NODE_MAJOR}.x, got $NODE_VERSION" >&2; exit 1 ;;
esac
echo "node $NODE_VERSION"
npm --version

echo "==> NodeSource LTS install complete"
