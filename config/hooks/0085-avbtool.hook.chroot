#!/bin/sh
# RootForge OS — avbtool + mkbootimg install from AOSP
# Victorious Framework | Origin Source Labs
#
# avbtool: re-signs vbmeta after patching boot/init_boot, or disables AVB
#          verification on eng builds. Python script from AOSP external/avb.
# mkbootimg / unpack_bootimg / repack_bootimg: creates/unpacks Android boot
#          images, header v3/v4 aware. From AOSP system/tools/mkbootimg.
#
# [Certain] neither avbtool nor mkbootimg is a real PyPI package — verified
# directly against pypi.org (both return a plain 404/"Not Found"); the
# previous version of this hook (`pip3 install avbtool mkbootimg`) always
# failed, and — since chroot hooks abort the whole build on a non-zero
# exit — would have taken every hook after it down too, once hook
# discovery itself got fixed (see HACKING.md and 0005-enable-live-groups
# for that story).
#
# Both are plain standalone Python scripts living in AOSP's own git trees
# (android.googlesource.com), fetched here from LineageOS's GitHub mirrors
# instead, which serve the identical AOSP source over plain HTTPS.
#
# Pinned to specific commit SHAs (not a branch name) with a SHA-256 for each
# fetched file, verified at pin time directly from a fresh clone of each
# mirror at that same commit. A branch name is a moving target — anything
# landing on lineage-22.2 between builds would get fetched and trusted
# silently. Pinning the commit makes the fetch itself reproducible; pinning
# the file hash on top of that means even a rewritten/force-pushed branch
# can't change what gets installed without the hash update being visible in
# a diff to this hook.
#
# mkbootimg.py imports a local gki/ submodule (no external pip dependency —
# Python's implicit namespace packages find it via the script's own
# directory) — that companion file has to ship alongside it or mkbootimg
# fails with ModuleNotFoundError on the very first invocation, not at
# install time.
#
# To bump: pick a newer commit on each mirror's branch, fetch each file at
# that commit, sha256sum it, and update the *_COMMIT and *_SHA256 values
# together.

set -e

AVB_COMMIT="6ee41dc37ea996a250f5c70d0ea16abb9f169975"
MKBOOTIMG_COMMIT="68697756a3ad6a2f123534b21ad55b9d4a97f0b5"
AVB_BASE="https://raw.githubusercontent.com/LineageOS/android_external_avb/${AVB_COMMIT}"
MKBOOTIMG_BASE="https://raw.githubusercontent.com/LineageOS/android_system_tools_mkbootimg/${MKBOOTIMG_COMMIT}"

TOOLS_DIR="/usr/local/lib/rootforge/avb-tools"
mkdir -p "$TOOLS_DIR/gki"

# fetch <url> <destination> <expected-sha256>
#
# Exits the whole hook cleanly (not the build) on a download failure,
# matching 0040-rpi-imager / 0062-payload-dumper's convention: a flaky fetch
# here shouldn't take the rest of the build down with it. A hash mismatch is
# different — that's not a flaky network, it's a changed artifact — so it
# fails the build hard rather than silently installing something unverified.
fetch() {
  url="$1"
  dest="$2"
  expected="$3"

  if ! curl -fsSL -o "$dest" "$url"; then
    echo "WARNING: failed to fetch $url"
    echo "         avbtool/mkbootimg install incomplete — scripts that need them"
    echo "         (flash_patched_boot.sh, kernelsu_patch_boot.sh) will error at runtime."
    exit 0
  fi

  actual="$(sha256sum "$dest" | awk '{print $1}')"
  if [ "$actual" != "$expected" ]; then
    echo "ERROR: SHA-256 mismatch for $url" >&2
    echo "  expected: $expected" >&2
    echo "  actual:   $actual" >&2
    rm -f "$dest"
    exit 1
  fi
}

echo "==> Fetching avbtool from AOSP (via LineageOS mirror, commit ${AVB_COMMIT})"
fetch "$AVB_BASE/avbtool.py" "$TOOLS_DIR/avbtool.py" \
  "2f8dfbf118e37566d8e3cf54fa252614955b7acc12c233a6b232068a3fae8f9f"

echo "==> Fetching mkbootimg + companions from AOSP (via LineageOS mirror, commit ${MKBOOTIMG_COMMIT})"
fetch "$MKBOOTIMG_BASE/mkbootimg.py" "$TOOLS_DIR/mkbootimg.py" \
  "021f2d960b2d3158a9df2ff6255f1140cebb09bc09f4886373438f2919559cd9"
fetch "$MKBOOTIMG_BASE/unpack_bootimg.py" "$TOOLS_DIR/unpack_bootimg.py" \
  "a9d260978a63bd06a24b6347e7dee8a28ff96639793caea15dff6aa491316308"
fetch "$MKBOOTIMG_BASE/repack_bootimg.py" "$TOOLS_DIR/repack_bootimg.py" \
  "b5e30899211f4d6ac7b1d6b53056585802aaab9f9b37f81da0f51ddb35291699"
fetch "$MKBOOTIMG_BASE/gki/generate_gki_certificate.py" "$TOOLS_DIR/gki/generate_gki_certificate.py" \
  "6ee0b2e3c3323ae8fccf326bf9a526451eac977005efabf7d129b3063bcfb945"

chmod +x "$TOOLS_DIR"/*.py

for tool in avbtool mkbootimg unpack_bootimg repack_bootimg; do
  cat > "/usr/local/bin/$tool" <<WRAPPER
#!/bin/sh
exec python3 "$TOOLS_DIR/${tool}.py" "\$@"
WRAPPER
  chmod +x "/usr/local/bin/$tool"
done

echo "==> Verifying"
avbtool version 2>&1 | head -1 || echo "avbtool installed (version check inconclusive)"
mkbootimg --help >/dev/null 2>&1 && echo "mkbootimg ok" || echo "mkbootimg installed (verify with: mkbootimg --help)"

echo "==> avbtool + mkbootimg + unpack_bootimg + repack_bootimg install complete"
