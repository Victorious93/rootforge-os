#!/bin/sh
# RootForge OS — live-build configuration
# Victorious Framework | Origin Source Labs
#
# Pin to Bookworm, GNOME, amd64 hybrid ISO with Calamares disk-install support.
# Run: sudo auto/build
#
# [Certain] the exact set of valid `lb config` flags is live-build-version-
# dependent — this was written against flag names (--bootloaders,
# --bootloader-timeout, --image-name, --utc-time) that don't exist in the
# live-build package actually shipped by Debian bookworm / current Ubuntu
# (3.0~a57): `lb config` treats unrecognized options as non-fatal warnings
# and keeps going, which combined with auto/build's own pipefail bug meant
# a build could "succeed" having done nothing. --bootloader grub2 is the
# value lb_binary_grub2 actually checks for to produce a UEFI-capable image
# (the enum in `lb config --help`, grub|syslinux|yaboot, is stale docs, not
# an enforced list — the parser accepts any string). There's no boot-menu-
# timeout or output-filename flag in this version at all: the timeout is
# whatever GRUB defaults to unless overridden via a
# config/bootloaders/grub2/ template, and auto/build renames the produced
# binary.hybrid.iso itself rather than relying on a --image-name flag.
#
# [Certain] --security false: lb_chroot_archives (read directly from the
# installed package) hardcodes "${DISTRIBUTION}/updates" as the security
# suite path for --mode debian, non-derivative builds, in both the
# chroot-install stage and the final-image stage that writes the
# persisted /etc/apt/sources.list. Debian renamed that suite to
# "${DISTRIBUTION}-security" back in bullseye (11); the old path 404s on
# bookworm (and everything since), which is what actually caused every
# real ISO build attempt to fail this whole session, once the recursion
# bug in auto/build (see that file's own header) stopped masking it.
# config/archives/rootforge-security.list replaces it with the correct
# modern path via live-build's own supported custom-archive mechanism.

set -e

lb config noauto \
  --distribution bookworm \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloader grub2 \
  --debian-installer none \
  --linux-flavours amd64 \
  --architectures amd64 \
  --mode debian \
  --apt-recommends false \
  --apt-options "--yes --no-install-recommends" \
  --compression xz \
  --security false \
  --zsync false \
  --iso-volume "RootForge OS" \
  --iso-application "RootForge OS — Android Root Module Development" \
  --iso-preparer "Victorious Framework | Origin Source Labs" \
  --iso-publisher "Origin Source Labs" \
  --memtest none \
  --system live \
  --initramfs live-boot \
  --firmware-binary true \
  --firmware-chroot true \
  "${@}"
