#!/usr/bin/env bash
# RootForge OS — Termux installer for release @TAG@
# Victorious Framework | Origin Source Labs
#
# GENERATED by termux/make-release-metadata.sh from the artifacts of release
# @TAG@; the tag, URLs and digests below were computed from those exact files.
# The copy under termux/templates/ is a template and refuses to run.
#
# Run from inside Termux:
#   curl -fsSLO @BASE_URL@/install.sh
#   curl -fsSLO @BASE_URL@/SHA256SUMS
#   sha256sum -c --ignore-missing SHA256SUMS      # checks install.sh itself
#   bash install.sh
#
# What it does: installs proot-distro, downloads the pinned plugin and refuses
# to use it unless its SHA-256 matches, then runs `proot-distro install
# rootforge`; proot-distro in turn checks the rootfs tarball against the digest
# written into that plugin.

set -euo pipefail

TAG="@TAG@"
BASE_URL="@BASE_URL@"
PLUGIN_URL="@BASE_URL@/rootforge-proot-plugin.sh"
PLUGIN_SHA256="@PLUGIN_SHA256@"
LAUNCHER_SHA256="@LAUNCHER_SHA256@"
CHROOT_SHA256_ARM64="@CHROOT_SHA256_ARM64@"
CHROOT_SHA256_AMD64="@CHROOT_SHA256_AMD64@"
PLUGIN_DIR="${PREFIX:-/data/data/com.termux/files/usr}/etc/proot-distro"

log() { echo "[rootforge-termux] $*"; }
die() { echo "[rootforge-termux] ERROR: $*" >&2; exit 1; }

case "$TAG$PLUGIN_SHA256" in
  *@*|"") die "This is the unreleased installer template. Use the install.sh published with a RootForge release." ;;
esac
[[ "$PLUGIN_SHA256" =~ ^[0-9a-f]{64}$ ]] || die "The embedded plugin digest is not a SHA-256 value."

command -v pkg >/dev/null 2>&1 || die "This doesn't look like Termux (no 'pkg' command) — run this inside the Termux app."

case "$(uname -m)" in
  aarch64) CHROOT_ARCH="arm64"; CHROOT_SHA256="$CHROOT_SHA256_ARM64" ;;
  x86_64)  CHROOT_ARCH="amd64"; CHROOT_SHA256="$CHROOT_SHA256_AMD64" ;;
  *) die "Unsupported CPU '$(uname -m)': RootForge publishes aarch64 and x86_64 root filesystems only." ;;
esac

# There are two variants, and picking the wrong one wastes a multi-GB
# download. Say which this device can use before starting it.
if command -v su >/dev/null 2>&1 && su -c 'id -u' 2>/dev/null | grep -q '^0$'; then
  log "This device appears to be ROOTED (su returned uid 0)."
  log ""
  log "You can use either variant:"
  log "  - PRoot (what this script installs): no root needed, ptrace-emulated."
  log "  - chroot (rootforge-chroot.sh): real chroot, noticeably faster, and"
  log "    it gets real device nodes — loop-mounting partition images, USB"
  log "    adb/fastboot without Termux:API, and /dev/net/tun for a userspace VPN."
  log ""
  if [[ -n "$CHROOT_SHA256" ]]; then
    log "For the chroot variant instead, fetch the rooted tarball and launcher, then verify:"
    log "  curl -fsSLO $BASE_URL/rootforge-chroot-$CHROOT_ARCH.tar.xz"
    log "  curl -fsSLO $BASE_URL/rootforge-chroot.sh"
    log "  echo '$LAUNCHER_SHA256  rootforge-chroot.sh' | sha256sum -c -"
    log "  chmod +x rootforge-chroot.sh"
    log "  ./rootforge-chroot.sh install rootforge-chroot-$CHROOT_ARCH.tar.xz --sha256 $CHROOT_SHA256"
  else
    log "No chroot rootfs for $CHROOT_ARCH was published with $TAG, so only the PRoot variant is available."
  fi
  log ""
  log "Neither variant runs harden_kernel.sh/harden_system.sh: those need"
  log "kernel subsystems Android does not ship, and root does not change"
  log "which kernel you are on. See README section 17."
  log ""
  log "Continuing with the PRoot variant in 5s — Ctrl-C to stop and use chroot instead."
  sleep 5
else
  log "No root detected — installing the PRoot variant, which is the right"
  log "  choice for an unrooted device."
fi

log "Installing proot-distro"
pkg install -y proot-distro

log "Fetching the RootForge OS $TAG plugin and verifying it"
mkdir -p "$PLUGIN_DIR"
PLUGIN_TMP="$(mktemp "$PLUGIN_DIR/.rootforge.sh.XXXXXX")"
trap 'rm -f "$PLUGIN_TMP"' EXIT
curl -fsSL -o "$PLUGIN_TMP" "$PLUGIN_URL"
ACTUAL="$(sha256sum "$PLUGIN_TMP" | awk '{print $1}')"
if [[ "$ACTUAL" != "$PLUGIN_SHA256" ]]; then
  die "The downloaded plugin does not match the digest published with $TAG.
       expected: $PLUGIN_SHA256
       actual:   $ACTUAL
       Nothing was installed."
fi
mv -f "$PLUGIN_TMP" "$PLUGIN_DIR/rootforge.sh"
trap - EXIT

log "Installing the rootfs (downloads a multi-GB tarball — Wi-Fi recommended)"
proot-distro install rootforge

log "Done. Log in with:"
log "  proot-distro login rootforge"
log ""
log "Inside the container, read /etc/rootforge/build-info for what this rootfs is, and run"
log "  bootstrap_proot.sh --plan      to see which Android SDK parts your CPU can run"
log "  bootstrap_proot.sh             to fetch them"
log "See README section 17 for what does and doesn't work in this non-root variant."
log ""
log "A graphical desktop is optional and is NOT in the published rootfs (it roughly triples"
log "the download). Install it on demand, inside the container:"
log "  rootforge_desktop.sh --install"
log "and on the Termux side, outside the container:"
log "  pkg install x11-repo && pkg install termux-x11-nightly"
log "  # plus the Termux:X11 APK from github.com/termux/termux-x11 releases"
log "  termux-x11 :0 &"
log "  proot-distro login rootforge --shared-tmp"
log "  # then inside the container:"
log "  rootforge_desktop.sh --check     # confirm the server is reachable"
log "  rootforge_desktop.sh             # start XFCE"

# Victorious Framework
