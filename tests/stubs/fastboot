#!/usr/bin/env bash
# Test stub for fastboot, modelled on AOSP fastboot.cpp:
#   * variable reports ("(bootloader) key: value", "Finished. ...") go to
#     STDERR, never stdout — a stub that prints them to stdout hides bugs in
#     callers that only read stdout;
#   * only commands that exist upstream are accepted. Anything else exits 1
#     with an "unknown command" message, so a script cannot pass by issuing
#     an invented verb (e.g. `wait-for-device`, which fastboot does not have);
#   * `-s SERIAL` must name an attached device (RF_STUB_FASTBOOT_DEVICES).
#
# Every call is recorded in RF_STUB_LOG. Knobs: RF_STUB_FASTBOOT_DEVICES,
# RF_STUB_GETVAR_ALL (the `getvar all` body), RF_STUB_FLASH_RC,
# RF_STUB_FLASH_FAIL_ON_CALL (fail only the Nth flash), RF_STUB_REBOOT_RC,
# RF_STUB_FLASH_SLEEP (seconds a flash takes, for interruption tests),
# RF_STUB_GETVAR_ALL_2 (what `getvar all` reports from the 2nd call on, to
# model a device that changed between checks), RF_STUB_TAMPER_FILE (appended
# to on the 2nd `getvar all`, to model an image changing after verification),
# RF_STUB_FETCH_FAIL (space-separated partitions whose `fetch` fails).
[ -n "${RF_STUB_LOG:-}" ] && printf 'fastboot %s\n' "$*" >> "$RF_STUB_LOG"

serial=""
slot=""
while [ $# -gt 0 ]; do
  case "$1" in
    -s) serial="${2:-}"; shift 2 ;;
    --slot) slot="${2:-}"; shift 2 ;;
    --slot=*) slot="${1#--slot=}"; shift ;;
    --set-active|--set-active=*|--force|--skip-reboot|-w) shift ;;
    -*) echo "fastboot: unknown option: $1" >&2; exit 64 ;;
    *) break ;;
  esac
done

attached() {
  printf '%b' "${RF_STUB_FASTBOOT_DEVICES:-}"
}

if [ -n "$serial" ]; then
  if ! attached | awk -v s="$serial" '$1 == s { found = 1 } END { exit !found }'; then
    echo "fastboot: error: no device with serial '$serial'" >&2
    exit 1
  fi
fi

cmd="${1:-}"
case "$cmd" in
  devices)
    attached
    ;;
  getvar)
    case "${2:-}" in
      all)
        COUNT_FILE="${RF_STUB_LOG:-/dev/null}.getvarcount"
        N=$(( $(cat "$COUNT_FILE" 2>/dev/null || echo 0) + 1 ))
        echo "$N" > "$COUNT_FILE"
        if [ "$N" -ge 2 ] && [ -n "${RF_STUB_GETVAR_ALL_2:-}" ]; then
          printf '%b' "$RF_STUB_GETVAR_ALL_2" >&2
        else
          printf '%b' "${RF_STUB_GETVAR_ALL:-}" >&2
        fi
        if [ "$N" -eq 2 ] && [ -n "${RF_STUB_TAMPER_FILE:-}" ]; then
          printf 'tampered' >> "$RF_STUB_TAMPER_FILE"
        fi
        echo "Finished. Total time: 0.002s" >&2
        ;;
      current-slot) printf 'current-slot: %s\nFinished. Total time: 0.001s\n' "${RF_STUB_SLOT:-a}" >&2 ;;
      product)      printf 'product: %s\nFinished. Total time: 0.001s\n' "${RF_STUB_PRODUCT:-testdevice}" >&2 ;;
      unlocked)     printf 'unlocked: %s\nFinished. Total time: 0.001s\n' "${RF_STUB_UNLOCKED:-yes}" >&2 ;;
      *) echo "getvar:${2:-}: FAILED (remote: 'GetVar Variable Not found')" >&2; exit 1 ;;
    esac
    ;;
  flash)
    partition="${2:-}"
    image="${3:-}"
    if [ -z "$partition" ] || [ ! -f "$image" ]; then
      echo "fastboot: error: cannot load '${image}'" >&2
      exit 1
    fi
    [ -n "${RF_STUB_FLASH_SLEEP:-}" ] && sleep "$RF_STUB_FLASH_SLEEP"
    # RF_STUB_FLASH_FAIL_ON_CALL lets a test fail the Nth flash only.
    if [ -n "${RF_STUB_FLASH_FAIL_ON_CALL:-}" ]; then
      COUNT_FILE="${RF_STUB_LOG:-/dev/null}.flashcount"
      N=$(( $(cat "$COUNT_FILE" 2>/dev/null || echo 0) + 1 ))
      echo "$N" > "$COUNT_FILE"
      [ "$N" = "$RF_STUB_FLASH_FAIL_ON_CALL" ] && exit 1
      exit 0
    fi
    exit "${RF_STUB_FLASH_RC:-0}"
    ;;
  fetch)
    partition="${2:-}"
    out="${3:-}"
    case " ${RF_STUB_FETCH_FAIL:-} " in
      *" $partition "*) echo "fetch:$partition FAILED (remote: 'not supported')" >&2; exit 1 ;;
    esac
    [ -n "$partition" ] && [ -n "$out" ] || exit 64
    printf 'image-of-%s%s' "$partition" "${slot:+-slot-$slot}" > "$out"
    ;;
  reboot) exit "${RF_STUB_REBOOT_RC:-0}" ;;
  set_active) exit 0 ;;
  oem|flashing) exit "${RF_STUB_FASTBOOT_RC:-0}" ;;
  "") exit 0 ;;   # option-only invocation such as `--set-active=a`
  *)
    echo "fastboot: unknown command: $cmd" >&2
    exit 64
    ;;
esac
